  "components": {
    "schemas": {
      "BatchBody": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind",
            "default": "card"
          },
          "contains": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contains"
          },
          "rules": {
