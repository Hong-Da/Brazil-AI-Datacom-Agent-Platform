{
  "openapi": "3.1.0",
  "info": {
    "title": "LucidMesh API",
    "description": "透网 LucidMesh 远程 API。除 /health 与首次运行向导外，所有接口都需要 Authorization: Bearer <令牌>。",
    "version": "0.0.1"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "健康检查（不需要认证）",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/setup": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "向导需要的参数定义（仅未配置时可用）",
        "operationId": "setup_schema_api_v1_setup_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Setup Schema Api V1 Setup Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "system"
        ],
        "summary": "提交向导结果（仅未配置时可用）",
        "operationId": "setup_apply_api_v1_setup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Setup Apply Api V1 Setup Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/config": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "当前生效的配置（敏感值只显示是否已设置）",
        "operationId": "effective_config_api_v1_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Effective Config Api V1 Config Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sanitize": {
      "post": {
        "tags": [
          "configs"
        ],
        "summary": "配置脱敏（返回脱敏后的文本与不含原值的替换报告）",
        "operationId": "sanitize_api_v1_sanitize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SanitizeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Sanitize Api V1 Sanitize Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/configs": {
      "post": {
        "tags": [
          "configs"
        ],
        "summary": "导入配置（可多个文件或 zip；识别厂商 → 脱敏 → 入库）",
        "operationId": "import_configs_api_v1_configs_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_import_configs_api_v1_configs_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Import Configs Api V1 Configs Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices": {
      "get": {
        "tags": [
          "configs"
        ],
        "summary": "已导入的设备与最新配置版本",
        "operationId": "devices_api_v1_devices_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Devices Api V1 Devices Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_import_configs_api_v1_configs_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files"
          },
          "level": {
            "type": "string",
            "enum": [
              "basic",
              "strict"
            ],
            "title": "Level",
            "default": "basic"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_import_configs_api_v1_configs_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SanitizeBody": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 20971520,
            "title": "Text"
          },
          "level": {
            "type": "string",
            "enum": [
              "basic",
              "strict"
            ],
            "title": "Level",
            "default": "basic"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "SanitizeBody"
      },
      "SetupBody": {
        "properties": {
          "language": {
            "type": "string",
            "title": "Language",
            "default": "zh-CN"
          },
          "values": {
            "additionalProperties": true,
            "type": "object",
            "title": "Values",
            "default": {}
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run",
            "default": false
          }
        },
        "type": "object",
        "title": "SetupBody"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
